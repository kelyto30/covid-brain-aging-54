# =============================================================
# .gitignore — covid-brain-aging-thesis
# =============================================================

# ---- R / RStudio ---------------------------------------------
.Rproj.user/
.Rhistory
.RData
.Rapp.history
.Renviron
*.Rproj
.Rprofile

# ---- Output directories generated by the pipeline ------------
# These are large and reproducible from the scripts. Do not commit.
outliers_included/
outputs/
figures/
tables/
rdata/

# ---- External data not bundled with the repo -----------------
# Salmon quants are downloaded from GEO, see data/README.md
quants/
GSE188847_quants/
*.salmon/
*.sf
*.sf.gz

# ---- Cached package state ------------------------------------
renv/library/
renv/staging/
.Rhistory.bak

# ---- macOS ---------------------------------------------------
.DS_Store
._.DS_Store
**/.DS_Store

# ---- Editor / IDE --------------------------------------------
.vscode/
.idea/
*.swp
*~

# ---- Build artifacts -----------------------------------------
*.log
*.aux
*.out
